{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neurospark",
  "main": "./server.js",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }

  // SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY se agregan
  // desde Cloudflare > Worker > Settings > Variables and Secrets.
  // Se omiten aquí para que el primer deploy pueda crear el Worker; luego se
  // agregan como secretos de runtime sin guardarlos en el repositorio.
}
